{
    "name": "roxone/movie-ripple",
    "description": "Movie CMS ripple theme",
    "type": "library",
    "authors": [
        {
            "name": "hacoidev",
            "email": "hacoi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "roxone/movie-core": "dev-main"
    },
    "license": "MIT",
    "autoload": {
